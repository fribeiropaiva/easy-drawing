# Absolute public URL of the site. Used for canonical links and Open Graph metadata.
# Optional locally (defaults to http://localhost:3000). Set it in Vercel for preview/production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog product analytics (lib/analytics). Optional: without a key nothing is sent, and
# `pnpm dev` logs events to the browser console instead. Data stays on the EU cloud by default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
