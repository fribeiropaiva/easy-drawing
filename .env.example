# Absolute public URL of the site, without a trailing slash. It is the canonical
# origin for canonical links, Open Graph URLs, the sitemap and robots.txt, so it
# must name the one hostname the site should be indexed under.
#
# Production: https://www.easydrawing.fun  (www is canonical; the apex redirects to it)
# Required on production deployments — the build fails without it (lib/env.ts).
# Optional locally and on Vercel previews, which fall back to the deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
